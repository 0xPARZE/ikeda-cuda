{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (CUDA if available)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "cpu-only",
      "displayName": "Release, CPU only (what CI runs)",
      "binaryDir": "${sourceDir}/build-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "IKEDA_ENABLE_CUDA": "OFF",
        "IKEDA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (syncs after every kernel launch)",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "cpu-only", "configurePreset": "cpu-only" },
    { "name": "debug", "configurePreset": "debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "cpu-only", "configurePreset": "cpu-only", "output": { "outputOnFailure": true } }
  ]
}
